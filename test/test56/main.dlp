// Negative comma expr test

bool is_prime(x:int) {
    if (x < 2) return false;
    for (var i = 2; i < x; i = i+1) {
        if (x%i == 0) return false;
    }
    return true;
}

int is_prime_int(x:int) {
    if (is_prime(x)) {
        return 1;
    } else {
        return 0;
    }
}

int main() {
    var x = 12;
    print_integer(print_integer(x), is_prime_int(x));

    var x = 419;
    print_integer(x);

    x = x+1, x+2;
    print_integer(x);

    var y = 0;
    y = x=x+1, x;
    print_integer(y);

    var z = 0;
    print_integer(z); //420

    z = x = x=x+1, x;
    print_integer(z); //421

    var a = 0;
    a = x = x+1, x+2;
    print_integer(a);
 
    var b = 30;
    return print_integer(b+100), b+100;
}
