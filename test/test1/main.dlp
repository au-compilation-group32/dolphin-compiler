    // Basic positive funtionalities
    var x = 1, y = x = x+2, z = x+y, t = read_integer();
    if (x == 3)
        print_integer(t);
    var u = 0;
    if (t <= x)
        u = z;
    else u = t;
    print_integer(x);
    print_integer(y);
    print_integer(z);
    print_integer(t);
    print_integer(u);
    return u; 