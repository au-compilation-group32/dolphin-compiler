// Positive recursion test

int even(x: int) {
    if (x == 0) return 1;
    return odd(x - 1);
}

int odd(x: int) {
    if (x == 0) return 0;
    return even(x-1);
}

int even_rec(x: int) {
    if (x == 0) return 1;
    if (even_rec(x-1)==1) {
        return 0;
    } else {
        return 1;
    }
}

int odd_rec(x: int) {
    if (x == 0) return 0;
    if (odd_rec(x- 1) == 1) return 0;
    return 1;
}

int main() {
    print_integer(even(12));
    print_integer(even(419));
    print_integer(odd(12));
    print_integer(odd(419));
    print_integer(even_rec(12));
    print_integer(even_rec(419));
    print_integer(odd_rec(12));
    print_integer(odd_rec(419));
    return 0;
}
