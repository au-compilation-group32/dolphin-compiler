// Positive escaped test

void print_string (s:string) {
  output_string (s, get_stdout());
  output_string ("\n", get_stdout());
}

record Animal {
  name: string;
  legs: int;
}

int main () {
  var x = "Hello World\n";
  print_string(x);
  print_integer(length_of(x));

  x = "Hello\tWorld";
  print_string(x);
  print_integer(length_of(x));

  x = "Hello\tWorld\n";
  print_string(x);
  print_integer(length_of(x));

  x = "Hello\\World";
  print_string(x);
  print_integer(length_of(x));

  x = "\"HelloWorld\"";
  print_string(x);
  print_integer(length_of(x));

  return 0;
}
