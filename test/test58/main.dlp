// Positive test

void print_string (s:string) {
  output_string (s, get_stdout());
  output_string ("\n", get_stdout());
}

record Animal {
  name: string;
  legs: int;
}

int main () {
  var x = "HelloWorld";
  print_string(x);
  print_integer(length_of(x));
  x = "HelloWorld";
  print_string(x);
  print_integer(length_of(x));
  x = "Hello World";
  print_string(x);
  print_integer(length_of(x));
  x = "Hello World\n";
  print_string(x);
  print_integer(length_of(x));
  x = "Hello World\n";
  print_string(x);
  print_integer(length_of(x));
  x = "Hello\tWorld";
  print_string(x);
  print_integer(length_of(x));
  x = "Hello\tWorld\n";
  print_string(x);
  print_integer(length_of(x));

  var cat: Animal = new Animal {name = "cat"; legs = 4;};
  var spider = new Animal {name = "spider"; legs = 8;};
  print_string(cat.name);
  print_integer(cat.legs);
  cat.legs = 2;
  print_string(cat.name);
  print_integer(cat.legs);
  print_string(spider.name);
  print_integer(spider.legs);
  return 0;
}
