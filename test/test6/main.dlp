int main() {
    //Test unop
    var x = read_integer();
    print_integer(x);
    var y = read_integer();
    print_integer(y);

    print_integer(-x);

    if (!x>=y)
        print_integer(x);
    else print_integer(-x);

    if (!x<=y)
        print_integer(x);
    else print_integer(-x);

    return 0;
}
