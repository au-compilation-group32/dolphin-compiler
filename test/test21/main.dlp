        for (var j = 0; j < 2; j = j+1) {
            for (var k = 0; k < 2; k = k+1) {
                if (k%2 == 0) {
                    print_integer(i);
                    print_integer(j);
                    print_integer(k);
                } else {
                    print_integer(i*10);
                    print_integer(j*10);
                    print_integer(k*10);
                }
            }
        }
    }

    print_integer(i);
    print_integer(j);
    print_integer(k);

