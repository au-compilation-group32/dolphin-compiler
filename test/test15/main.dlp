int main() {
    // for loop without some clauses
    var i = 0;
    for (; i < 5; i = i+1)
        print_integer(i);

    for (var i = 0; ; i = i+1) {
        if (i >= 5)
            break;
        print_integer(i);
    }

    for (var i = 0; i < 5; ) {
        print_integer(i);
        i = i+1;
    }
    
    for (var i = 0; ; ) {
        if (i >= 5)
            break;
        print_integer(i);
        i = i+1;
    }

    var i = 0;
    for (; i < 5; ) {
        print_integer(i);
        i = i+1;
    }

    var i = 0;
    for (; ; i = i+1) {
        if (i >= 5)
            break;
        print_integer(i);
    }

    var i = 0;
    for (; ; ) {
        if (i >= 5)
            break;
        print_integer(i);
        i = i+1;
    }
    return 0;
}
