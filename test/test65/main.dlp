// Negative nil test

void print_string (s:string) {
  output_string (s, get_stdout());
  output_string ("\n", get_stdout());
}

record Animal {
  name: string;
  legs: int;
}

int main () {
  var cat = nil;
  cat = new Animal {name = "cat"; legs = 4;};

  var x :int = nil;

  var a = nil;
  a = new int[3];

  var cat = new Animal {name = "cat"; legs = 4;};
  var a = new int[3];
  if (cat > nil) {}
  if (cat < nil) {}
  if (cat == nil) {}
  if (cat != nil) {}
  if (a > nil) {}
  if (a < nil) {}
  if (a == nil) {}
  if (a != nil) {}
  return 0;
}
